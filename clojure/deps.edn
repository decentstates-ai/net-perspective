{:paths ["src"]

 :deps {org.clojure/clojure                          {:mvn/version "1.12.0"}
        ;; crypto — bcprov 1.80+ includes ML-DSA (FIPS 204) in the pqc.crypto.mldsa package
        org.bouncycastle/bcprov-jdk18on              {:mvn/version "1.80"}
        ;; schema, encoding, validation
        metosin/malli                                 {:mvn/version "0.16.4"}
        io.github.erdtman/java-json-canonicalization {:mvn/version "1.1"}
        cheshire/cheshire                             {:mvn/version "5.13.0"}
        ;; http server
        ring/ring-core                                {:mvn/version "1.12.2"}
        ring/ring-jetty-adapter                       {:mvn/version "1.12.2"}
        metosin/reitit                                {:mvn/version "0.7.2"}
        ;; http client (multipart for IPFS /add)
        clj-http/clj-http                             {:mvn/version "3.13.0"}
        ;; cli
        org.babashka/cli                               {:mvn/version "0.8.66"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1"
                        :git/sha "dfb30dd"}
                       ring/ring-mock              {:mvn/version "0.4.0"}
                       org.clojure/test.check      {:mvn/version "1.1.1"}
                       com.gfredericks/test.chuck  {:mvn/version "0.2.14"}}}

  :build {:deps     {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
